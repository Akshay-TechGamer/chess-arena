{
  "name": "chess-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run copy-engine && next dev --turbopack",
    "prebuild": "npm run copy-engine",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-engine": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.1.0",
    "stockfish": "^18.0.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
