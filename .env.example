# Copy to .env.local and fill in. .env.local is git-ignored.
# Values come from the Supabase dashboard (Settings -> API) — Phase 2 (online mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
